# AdStudio-Lab 접속 대상 설정 (전부 선택 사항)
#
# 이 파일을 .env.local 로 복사한 뒤 필요한 값만 채운다.
# 아무것도 채우지 않으면(=.env 파일이 없으면) 기존과 동일하게
# 운영 프로젝트 headjim-ai 에 붙는다 — 도입 전 동작과 같다.
#
# ⚠️ Vite 는 빌드타임에 문자열을 치환한다. 값을 바꾸면 반드시 재빌드할 것.

# ── 로컬 에뮬레이터 격리 (권장: 워크플로우 개발은 이걸 켠다) ──
# true 로 두면 Auth·Firestore 가 로컬 에뮬레이터에 붙어
# 운영 계정·지갑·프로젝트 문서를 전혀 건드리지 않는다.
# VITE_USE_EMULATORS=true
# VITE_AUTH_EMULATOR_PORT=9099
# VITE_FIRESTORE_EMULATOR_PORT=8080

# ── 함수 호출 대상 ──
# 미지정 시 hostname 이 localhost/127.0.0.1 이면 에뮬레이터, 아니면 프로덕션.
# VITE_USE_FN_EMULATOR=true
# VITE_FN_EMULATOR_PORT=5001
# VITE_FN_REGION=us-central1

# ── 별도 Firebase 프로젝트로 옮길 때만 채운다 ──
# projectId 만 채우면 authDomain·storageBucket 은 자동 유도된다.
# VITE_FB_PROJECT_ID=
# VITE_FB_API_KEY=
# VITE_FB_AUTH_DOMAIN=
# VITE_FB_STORAGE_BUCKET=
# VITE_FB_MSG_SENDER_ID=
# VITE_FB_APP_ID=
# VITE_FB_MEASUREMENT_ID=

# ── App Check ──
# 사이트 키는 프로젝트 종속이다. 새 프로젝트에서 키를 아직 안 만들었으면 false 로 끈다.
# VITE_APPCHECK_SITE_KEY=
# VITE_APPCHECK_ENABLED=false

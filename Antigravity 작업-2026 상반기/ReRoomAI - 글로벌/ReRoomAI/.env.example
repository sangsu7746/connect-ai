# ── Required ──────────────────────────────────────────────────────────
# Google Gemini API key (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Accounts & credits (optional — app runs in anonymous demo mode without these) ──
# Firebase web app config: Firebase Console → Project settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account JSON (raw or base64): Project settings → Service accounts → Generate new private key
# This is the DATA project (credits, orders, share images).
FIREBASE_SERVICE_ACCOUNT=

# Project whose ID tokens are accepted — the shared HEADJIM user pool, so a uid here
# is the same uid as wallets/{uid}. Leave blank to use the service account's own project.
FIREBASE_AUTH_PROJECT_ID=headjim-ai
# Storage bucket for share pages (defaults to <project-id>.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ── Payments via PayPal (optional; requires Firebase above) ───────────
# REST app credentials: https://developer.paypal.com → Apps & Credentials
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "live" for production
PAYPAL_ENV=sandbox

# Cloudflare 대시보드(dash.cloudflare.com) 우측에서 확인
CF_ACCOUNT_ID=your_account_id_here

# My Profile > API Tokens > Create Token > "Workers AI" 템플릿으로 발급
CF_API_TOKEN=your_api_token_here

# 로컬 프록시 서버 포트 (web/vite.config.js의 proxy와 일치해야 함)
PORT=8789

# 개발용 일일 생성 한도 (IP당)
DAILY_LIMIT=30

# (선택) Gemini 프리미엄 모드 — https://aistudio.google.com 에서 무료 발급
# 비워두면 Premium 토글 사용 시 안내 오류만 표시됨
GEMINI_API_KEY=

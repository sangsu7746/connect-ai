# 업종 프로필 (profiles/*.yaml) — 전환하면 브랜드·의무표기·금칙어·소재출처가 통째로 바뀜
AUTOAD_PROFILE=loan

# AutoAd 시크릿 — 이 파일을 .env 로 복사 후 값 채우기 (.env 는 커밋 금지)
# ⚠ 대출위젯-카카오/config.py 에 노출됐던 Groq 키는 반드시 폐기·재발급 후 사용할 것.

# 카피 생성 (Claude)
ANTHROPIC_API_KEY=

# 서류 파싱 (Groq) — 재발급본
GROQ_API_KEY=

# PrintCraft 팜플렛 배경 생성
CF_API_TOKEN=
CF_ACCOUNT_ID=
GEMINI_API_KEY=

# 승인 콘솔 (텔레그램)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 외부 시스템 주소 (기본값 사용 시 비워도 됨)
LOAN_API_BASE=http://127.0.0.1:8000
PRINTCRAFT_BASE=http://127.0.0.1:8787
# 접수폼 공개 주소 — 광고 CTA 링크로 삽입됨. 실발행 전 외부 주소로 교체 필수!
# 배포 후: https://headjim-loan.web.app
PUBLIC_BASE=http://127.0.0.1:8010

# 클라우드 수신함 회수 (cloud_sync.py) — Firebase 배포 후 설정
LEAD_PULL_URL=
LEAD_PULL_TOKEN=

# 공용 DB로 합치려면 대출앱 kakao_crawl.db 절대경로 지정 (기본: 자체 autoad.db)
# AUTOAD_DB=

# 운영 안전장치
GLOBAL_DRY_RUN=1
DAILY_POST_LIMIT=10
COPY_PROVIDER=gemini            # gemini(무료티어·저비용) | claude(품질)
COPY_MODEL_GEMINI=gemini-2.5-flash-lite
COPY_MODEL=claude-sonnet-5     # COPY_PROVIDER=claude 일 때 사용

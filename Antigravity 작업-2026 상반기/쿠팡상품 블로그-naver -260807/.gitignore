# 비밀정보 — config.json 에 네이버 계정과 API 키가 평문으로 들어 있다.
# 이 디렉터리에는 .gitignore 가 아예 없어서 `git add .` 한 번이면 커밋될 수 있었다.
config.json
config.json.bak          # 키 교체 시 만드는 백업. 옛 키와 비밀번호가 그대로 들어 있다
*.bak
*.key
.env
.env.*

# 브라우저 로그인 세션 (쿠키·토큰이 그대로 들어 있다)
.tistory_profile/
.coupang_profile/
.partners_profile/
*_profile/

# 데이터베이스와 백업
*.db
*.db.bak-*
*.sqlite3

# 생성물 — 코드가 언제든 다시 만든다. 저장소에 넣을 이유가 없다.
output/
outputs/
reels_output/
temp_images/
temp_product_imgs/
temp_blog_imgs/
logs/
*.mp4
*.png
*.jpg
*.jpeg
__pycache__/
*.pyc
.venv/

# 실행 상태 파일
.daily_state.json
